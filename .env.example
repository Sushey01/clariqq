# Copy to .env and fill in. Do not commit .env.
#
# Deploy the GPU server first:
#   pip install modal && modal setup
#   modal secret create clariq-llm CLARIQ_MODAL_KEY=clariq-modal
#   modal deploy modal/serve_socratic.py
# Then paste the printed URL into MODAL_BASE_URL (keep /v1).
# Stop when idle: modal app stop clariq-socratic

LLM_PROVIDER=modal
MODAL_BASE_URL=https://YOUR-WORKSPACE--clariq-socratic-serve.modal.run/v1
MODAL_API_KEY=clariq-modal
MODAL_MODEL=socratic-phi3

# LLM_PROVIDER=local
# LLM_PROVIDER=groq
# GROQ_API_KEY=
